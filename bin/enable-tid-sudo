#!/usr/bin/env bash

set -euo pipefail

pam_dir=/etc/pam.d
custom_pam_dir=0
check_only=0

while (( $# > 0 )); do
  case $1 in
    --check) check_only=1; shift ;;
    --pam-dir)
      if (( $# < 2 )); then
        echo '--pam-dir requires a directory.' >&2
        exit 2
      fi
      pam_dir=$2
      custom_pam_dir=1
      shift 2
      ;;
    -h|--help)
      echo 'Usage: enable-tid-sudo [--check] [--pam-dir DIRECTORY]'
      echo 'Enable Touch ID in sudo_local, preserving existing PAM rules.'
      echo '--check reports the current state without changing it.'
      echo '--pam-dir selects an alternate PAM directory without automatic sudo.'
      exit 0
      ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [[ $(/usr/bin/uname -s) != Darwin ]]; then
  echo 'This helper requires macOS.' >&2
  exit 1
fi

if ! /usr/bin/grep -Eq '^[[:space:]]*auth[[:space:]]+include[[:space:]]+sudo_local([[:space:]]|$)' "$pam_dir/sudo"; then
  echo 'This PAM configuration does not support sudo_local.' >&2
  exit 1
fi

readonly target="$pam_dir/sudo_local"
readonly enabled_rule='^[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so(\.[0-9]+)?([[:space:]]|$)'

if [[ -L $target || ( -e $target && ! -f $target ) ]]; then
  echo 'sudo_local must be a regular file, not a symlink or directory.' >&2
  exit 1
fi

if [[ -r $target ]] && /usr/bin/grep -Eq "$enabled_rule" "$target"; then
  echo 'Touch ID is already enabled for sudo.'
  exit 0
fi

if [[ -r $target ]] && /usr/bin/grep -Eq '^[[:space:]]*auth[[:space:]]+[^[:space:]]+[[:space:]]+pam_tid\.so(\.[0-9]+)?([[:space:]]|$)' "$target"; then
  echo 'sudo_local has a custom Touch ID rule; leaving it unchanged.' >&2
  exit 1
fi

if (( check_only )); then
  echo 'Touch ID is not enabled for sudo.'
  exit 1
fi

if (( ! custom_pam_dir && EUID != 0 )); then
  exec /usr/bin/sudo -- /bin/bash "${BASH_SOURCE[0]}"
fi

input="$pam_dir/sudo_local.template"
backup=
if [[ -e $target ]]; then
  backup=$(/usr/bin/mktemp "$pam_dir/sudo_local.before-touch-id.XXXXXX")
  /bin/cp -p "$target" "$backup"
  input=$backup
fi

if [[ ! -r $input ]]; then
  echo "Cannot read PAM configuration: $input" >&2
  exit 1
fi

temporary=$(/usr/bin/mktemp "$pam_dir/.sudo_local.XXXXXX")
trap '/bin/rm -f -- "$temporary"' EXIT

/usr/bin/awk '
  !enabled && /^[[:space:]]*#[[:space:]]*auth[[:space:]]+sufficient[[:space:]]+pam_tid\.so(\.[0-9]+)?([[:space:]]|$)/ {
    sub(/^[[:space:]]*#[[:space:]]*/, "")
    enabled = 1
  }
  { print }
  END { if (!enabled) print "auth sufficient pam_tid.so" }
' "$input" > "$temporary"

/bin/chmod 0644 "$temporary"
if (( ! custom_pam_dir )); then
  /usr/sbin/chown root:wheel "$temporary"
fi

if [[ -n $backup ]]; then
  if ! /usr/bin/cmp -s "$target" "$backup"; then
    echo 'sudo_local changed during setup; leaving it untouched.' >&2
    exit 1
  fi
elif [[ -e $target || -L $target ]]; then
  echo 'sudo_local appeared during setup; leaving it untouched.' >&2
  exit 1
fi

/bin/mv -f "$temporary" "$target"
echo 'Enabled Touch ID for sudo.'
if [[ -n $backup ]]; then
  echo "Backup: $backup"
fi
