#!/usr/bin/env bash

set -euo pipefail

if (( $# > 0 )); then
  if (( $# == 1 )) && [[ $1 == --help || $1 == -h ]]; then
    echo 'Usage: fuspm'
    echo 'Remove the SwiftPM cache while preserving SwiftPM configuration.'
    exit 0
  fi
  echo 'Usage: fuspm' >&2
  exit 2
fi

readonly cache_dir="$HOME/Library/Caches/org.swift.swiftpm"

if [[ ! -e $cache_dir && ! -L $cache_dir ]]; then
  echo 'SwiftPM cache has already been removed.'
  exit 0
fi

echo "Removing $cache_dir"
rm -rf -- "$cache_dir"
